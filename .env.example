# Database connection
# Hostname where PostgreSQL is reachable
DB_HOST=localhost
# TCP port for PostgreSQL
DB_PORT=5432
# Database user with read/write access
DB_USER=postgres
# Password for the database user
DB_PASSWORD=postgres
# Name of the application database
DB_NAME=treehole
# Maximum number of pooled PostgreSQL clients (optional)
DB_MAX_CLIENTS=10
# Milliseconds before idle clients are closed (optional)
DB_IDLE_TIMEOUT=30000
# Statement timeout in milliseconds (optional)
DB_STATEMENT_TIMEOUT=120000
# Query timeout in milliseconds (optional)
DB_QUERY_TIMEOUT=120000

# Casdoor / NextAuth configuration
# Base URL of your Casdoor deployment (no trailing slash)
CASDOOR_ENDPOINT=https://casdoor.example.com
# OAuth client ID registered in Casdoor
CASDOOR_CLIENT_ID=replace-with-client-id
# OAuth client secret registered in Casdoor
CASDOOR_CLIENT_SECRET=replace-with-client-secret
# Casdoor organization name if scoped auth is needed (optional)
CASDOOR_ORGANIZATION_NAME=replace-with-organization
# Casdoor application name if scoped auth is needed (optional)
CASDOOR_APP_NAME=replace-with-application

# Public URL of this Next.js app (used by NextAuth)
NEXTAUTH_URL=http://localhost:3000
# Secret value used to sign NextAuth tokens
NEXTAUTH_SECRET=replace-with-random-secret
# Enable verbose NextAuth logging when set to "true"
NEXTAUTH_DEBUG=false

# Fallback callback URL when the original redirect target is invalid
NEXT_PUBLIC_DEFAULT_CALLBACK_URL=/

# Maximum number of latest posts considered for search/hot pages on the server
RECENT_HOLE_LIMIT=10000
# Same cap exposed to the browser; overrides RECENT_HOLE_LIMIT for client hints
NEXT_PUBLIC_RECENT_HOLE_LIMIT=10000
